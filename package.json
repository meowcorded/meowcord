{
  "name": "meowcord",
  "version": "0.1.0-alpha.1",
  "description": "Self-hosted server for the Discord API and gateway that serves a rebranded official Discord web client with Equicord",
  "homepage": "https://github.com/meowcorded/meowcord",
  "bugs": {
    "url": "https://github.com/meowcorded/meowcord/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "Spacebar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meowcorded/meowcord.git"
  },
  "main": "dist/bundle/index.js",
  "types": "src/bundle/index.ts",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "bun dist/bundle/start.js",
    "start:api": "bun dist/api/start.js",
    "start:cdn": "bun dist/cdn/start.js",
    "start:gateway": "bun dist/gateway/start.js",
    "start:webrtc": "bun dist/webrtc/start.js",
    "build": "bun run build:src && bun run generate:schema && bun run generate:openapi",
    "build:src": "rm -rf dist && tsc -b && cp scripts/dist-tsconfig.json dist/tsconfig.json && bun scripts/default-avatars.js",
    "build:e2ee": "tsc -p client/e2ee && bun scripts/build-e2ee.js",
    "build:equicord": "bun scripts/vencord.js",
    "typecheck:equicord": "bun scripts/vencord.js --typecheck",
    "build:vencord": "bun scripts/vencord.js",
    "watch": "tsc -w -b .",
    "typecheck": "tsc -b && tsc -p client/e2ee",
    "test": "bun test --timeout 20000 scripts/tests scripts/dev dist",
    "lint": "biome lint",
    "format": "biome format --write",
    "setup": "bun run build",
    "generate:rights": "bun scripts/rights.js",
    "generate:client": "bun scripts/client.js && bun scripts/e2ee-anchors.js && bun scripts/clan-badges.js && bun scripts/vencord.js && bun scripts/compress-client.js",
    "generate:clan-badges": "bun scripts/clan-badges.js",
    "check:client": "bun scripts/vencord.js --reporter && bun scripts/vencord-check.mjs",
    "check:e2ee-anchors": "bun scripts/e2ee-anchors.js",
    "generate:schema": "bun scripts/schema.js",
    "generate:migration": "bun node_modules/typeorm/cli.js migration:generate -d dist/database/Database.js",
    "generate:openapi": "bun scripts/openapi.js",
    "apply:migrations": "bun dist/apply-migrations.js",
    "dev:setup": "scripts/dev/worktree-setup.sh",
    "release:pack": "bun scripts/release.js"
  },
  "dependencies": {
    "@cap.js/wasm": "0.0.8",
    "@cap.js/widget": "0.1.58",
    "@hpke/core": "^1.9.0",
    "@spacebarchat/pion-webrtc": "^0.0.4",
    "@toondepauw/node-zstd": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqplib": "^2.0.1",
    "badge-maker": "^6.0.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.3.0",
    "capjs-core": "0.1.3",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "discord-protos": "^1.2.362",
    "email-providers": "^2.25.0",
    "exif-be-gone": "^1.5.1",
    "express": "^5.2.1",
    "fast-zlib": "^2.0.1",
    "fido2-lib": "^3.5.9",
    "file-type": "^22.0.2",
    "form-data": "^4.0.6",
    "harmony-erlpack": "^0.0.1",
    "i18next": "^26.4.1",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-middleware": "^3.9.8",
    "image-size": "^2.0.4",
    "json-bigint": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "mediabunny": "1.61.3",
    "morgan": "^1.12.1",
    "ms": "^2.1.3",
    "multer": "^2.4.0",
    "murmurhash-js": "^1.0.0",
    "node-2fa": "^2.0.3",
    "node-unix-socket": "^0.2.7",
    "pako": "2.1.0",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "picocolors": "^1.1.1",
    "probe-image-size": "^7.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "sax": "^1.6.1",
    "tslib": "^2.8.1",
    "typeorm": "^1.1.1",
    "why-is-node-running": "^3.2.2",
    "wretch": "^3.0.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@spacebarchat/spacebar-webrtc-types": "^1.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/i18next-node-fs-backend": "^2.1.5",
    "@types/json-bigint": "^1.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/murmurhash-js": "^1.0.7",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pako": "2.0.4",
    "@types/probe-image-size": "^7.2.5",
    "@types/sax": "^1.2.7",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "hash-wasm": "^4.12.0",
    "typescript": "^6.0.3",
    "typescript-json-schema": "^0.68.0"
  },
  "optionalDependencies": {
    "@sendgrid/mail": "^8.1.6",
    "jimp": "^1.6.1",
    "mailgun.js": "^13.3.0",
    "node-mailjet": "^6.0.11",
    "nodemailer": "^10.0.16",
    "sharp": "^0.35.5"
  },
  "patchedDependencies": {
    "ajv@8.20.0": "patches/ajv@8.20.0.patch",
    "mediabunny@1.61.3": "patches/mediabunny@1.61.3.patch",
    "@types/dom-mediacapture-transform@0.1.12": "patches/@types%2Fdom-mediacapture-transform@0.1.12.patch",
    "body-parser@2.3.0": "patches/body-parser@2.3.0.patch",
    "express@5.2.1": "patches/express@5.2.1.patch",
    "typescript-json-schema@0.68.0": "patches/typescript-json-schema@0.68.0.patch",
    "@jimp/plugin-print@1.6.1": "patches/@jimp%2Fplugin-print@1.6.1.patch"
  },
  "trustedDependencies": [
    "bcrypt",
    "cbor-extract",
    "sharp",
    "esbuild"
  ]
}
